.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
dist/
*.conf
# ...except the site's nginx snippets (seed confs stay ignored everywhere else)
!deploy/nginx/*.conf
private/
data/
!apps/web/data/
apps/web/data/*.json
!apps/web/data/sample-*.json
!apps/web/data/README.md

# Claude Code local worktrees and session state
.claude/

# Local audit reports (not versioned)
/audit/

# A live combat export is served by the data server, never committed: only the
# recorded sample the site falls back to lives in git.
/apps/web/data/combat/v1/*
!/apps/web/data/combat/v1/sample/

